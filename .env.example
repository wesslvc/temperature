# Vercel 환경변수 (Project Settings > Environment Variables)
TUYA_CLIENT_ID=
TUYA_CLIENT_SECRET=
# 비우면 데이터센터를 자동 탐색
TUYA_ENDPOINT=
# 비우면 연결된 온습도 센서를 자동 탐색
TUYA_DEVICE_ID=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# /api/collect 호출 인증용 (Supabase roomtemp.config 의 ingest_token 과 동일)
INGEST_TOKEN=
# 집 위치 위성 일사량 (공공데이터포털 '한국에너지기술연구원_실시간 일사량 데이터 제공 서비스')
DATA_GO_KR_KEY=
# 비우면 고덕로 360 근처 격자 (37.552, 127.169)
GHI_LAT=
GHI_LON=

# HT 홈서비스(월패드) 난방 상태 읽기 — 값은 Vercel 환경변수에만 (저장소에 넣지 말 것)
HT_ID=
HT_PW=
HT_HOUSE=siteId/동/호
