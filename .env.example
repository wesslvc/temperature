# https://iot.tuya.com 에서 Cloud Project 생성 후 발급
TUYA_CLIENT_ID=
TUYA_CLIENT_SECRET=
# 데이터센터 (계정 지역에 맞게): 미국 https://openapi.tuyaus.com / 유럽 https://openapi.tuyaeu.com / 중국 https://openapi.tuyacn.com / 인도 https://openapi.tuyain.com
TUYA_ENDPOINT=https://openapi.tuyaus.com
# 쉼표로 구분한 디바이스 ID (Smart Life 앱 > 기기 정보 > 가상 ID). 비우면 프로젝트에 연결된 온습도 기기를 자동 탐색
TUYA_DEVICE_IDS=
# 수집 주기(초)
POLL_SECONDS=60
PORT=3000
# 1 이면 가짜 데이터로 UI 체험
DEMO=0
