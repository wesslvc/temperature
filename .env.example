# Vercel 환경변수 (Project Settings > Environment Variables)
TUYA_CLIENT_ID=
TUYA_CLIENT_SECRET=
# 비우면 데이터센터를 자동 탐색
TUYA_ENDPOINT=
# 비우면 연결된 온습도 센서를 자동 탐색
TUYA_DEVICE_ID=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# /api/collect 호출 인증용 (Supabase roomtemp.config 의 ingest_token 과 동일)
INGEST_TOKEN=
# 집 앞 S-DoT(서울 열린데이터광장 sDoTEnv) 조도 수집용
SDOT_API_KEY=
# 비우면 고덕로 227(고덕1동, V02Q1940350). 집 앞 고덕로 360은 조도 센서가 0만 보냄
SDOT_SERIAL=
# 화면에 보일 이름 (SDOT_SERIAL을 바꿨을 때)
SDOT_NAME=
